# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Local only: an HTTPS URL registered under "Allowed redirect URIs" in the Plaid
# dashboard, needed for banks that sign you in on their own site (e.g. Wells Fargo).
# PLAID_REDIRECT_URI=https://<your-tunnel>/plaid

# Password for the whole app. Required on Vercel (the app refuses to serve without it).
APP_PASSWORD=

# Deployed copies can't save files, so set the token here instead. Link a bank
# locally once, then copy accessToken from .plaid/data.json.
# PLAID_ACCESS_TOKEN=
