// Run with: node --experimental-strip-types scripts/test-card-matching.mts
import { matchCardPayments, type MatchTxn } from "../lib/plaidCardMatching.ts";
const accounts = [{ id: "chk", type: "depository" }, { id: "sav", type: "depository" }, { id: "cc1", type: "credit" }, { id: "cc2", type: "credit" }];
let n = 0; const t = (date: string, name: string, amount: number, accountId: string, detailed?: string): MatchTxn => ({ id: `t${++n}`, date, name, amount, accountId, detailed });
let fails = 0;
const check = (label: string, txns: MatchTxn[], expectBank: string[], expectCard: string[]) => {
  const r = matchCardPayments(txns, accounts);
  const b = [...r.bankSideIds].sort().join(","), c = [...r.cardSideIds].sort().join(",");
  const ok = b === expectBank.sort().join(",") && c === expectCard.sort().join(",");
  if (!ok) fails++;
  console.log(ok ? "PASS" : "FAIL", label, ok ? "" : `bank=[${b}] card=[${c}]`);
};
n = 0;
const a = t("2026-09-18", "CHASE CREDIT CRD AUTOPAY 260918 0001", 1268.10, "chk"), b = t("2026-09-18", "Payment Thank You - Web", -1268.10, "cc1");
check("same-day exact match", [a, b], [a.id], [b.id]);
n = 0;
const a2 = t("2026-09-17", "CHASE CREDIT CRD AUTOPAY", 753.73, "chk"), b2 = t("2026-09-19", "AUTOMATIC PAYMENT - THANK YOU", -753.73, "cc1");
check("card posts 2 days later", [a2, b2], [a2.id], [b2.id]);
n = 0;
const a3 = t("2026-09-17", "Online Transfer to Wells Fargo Active Cash", 204.44, "chk"), b3 = t("2026-09-17", "PAYMENT THANK YOU", -204.40, "cc1");
check("different amount is not a match", [a3, b3], [], []);
n = 0;
const a4 = t("2026-09-01", "Online Transfer to Wells Fargo Active Cash", 100, "chk"), b4 = t("2026-09-10", "PAYMENT THANK YOU", -100, "cc1");
check("9 days apart is outside the window", [a4, b4], [], []);
n = 0;
const a5 = t("2026-09-10", "Coffee Shop", 12, "chk"), b5 = t("2026-09-10", "Amazon refund", -12, "cc1");
check("card refund is not a payment; plain purchase is not a payment", [a5, b5], [], []);
n = 0;
const a6 = t("2026-09-10", "Online Transfer to card", 50, "chk"), b6 = t("2026-09-10", "Refund - Target", -50, "cc1");
check("payment-like bank line but card credit is a refund", [a6, b6], [], []);
n = 0;
const a7 = t("2026-09-10", "Online Transfer to card", 50, "chk"), a8 = t("2026-09-12", "Online Transfer to card", 50, "chk"), b7 = t("2026-09-11", "PAYMENT THANK YOU", -50, "cc1");
check("two bank payments, one card credit: only one pairs", [a7, a8, b7], [a7.id], [b7.id]);
n = 0;
const a9 = t("2026-09-10", "Online Transfer to card", 50, "chk"), a10 = t("2026-09-10", "Online Transfer to card", 50, "sav"), b9 = t("2026-09-10", "PAYMENT", -50, "cc1"), b10 = t("2026-09-11", "PAYMENT", -50, "cc2");
check("two payments, two cards: pairs one to one", [a9, a10, b9, b10], [a9.id, a10.id], [b9.id, b10.id]);
n = 0;
const a11 = t("2026-09-10", "Transfer", 75, "chk", "LOAN_PAYMENTS_CREDIT_CARD_PAYMENT"), b11 = t("2026-09-10", "Something odd", -75, "cc1", "LOAN_PAYMENTS_CREDIT_CARD_PAYMENT");
check("Plaid's detailed category matches even when names don't", [a11, b11], [a11.id], [b11.id]);
n = 0;
const a12 = t("2026-09-10", "Online Transfer to card", 50, "chk");
check("bank payment with no card side stays counted", [a12], [], []);
n = 0;
const b13 = t("2026-09-10", "PAYMENT THANK YOU", -50, "cc1");
check("card credit with no bank side is left alone", [b13], [], []);
n = 0;
const a14 = t("2026-09-10", "Online Transfer to card", 50, "cc2"), b14 = t("2026-09-10", "PAYMENT", -50, "cc1");
check("card-to-card is not a bank payment", [a14, b14], [], []);
n = 0;
const a15 = t("2026-09-30", "Autopay", 300, "chk"), b15 = t("2026-10-01", "PAYMENT THANK YOU", -300, "cc1");
check("month boundary (Sep 30 / Oct 1) still pairs", [a15, b15], [a15.id], [b15.id]);
console.log(fails === 0 ? "\nALL PASSED" : `\n${fails} FAILED`);
process.exit(fails ? 1 : 0);
